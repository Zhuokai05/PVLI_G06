            + activarAzul()
            + activarVerde()
            + abrirPuerta()
        }
        class FinalBossDoor {
            - iraboss : boolean
            - tristeboss : boolean
            --
            + constructor(...)
            + abrirPuerta()
        }
    }

    package "Interactables & Platforms" {
        class BasePlatform {
            + isDeactivated : boolean
            + isShaking : boolean
            - particles : object
            - breakSound : Sound
            --
            + constructor(...)
            + deactivateByPunch()
            - startShakeEffect()
            - breakPlatform()
            - createBreakParticles()
            + reactivate()
            + action()
        }
        class IcePlatform {
            + congelado : boolean
            --
            + constructor(...)
            + congelar()
            + descongelar()
            - _activarPlataforma()
            - _desactivarPlataforma()
            + action()
        }
        class Checkpoint {
            + activated : boolean
            + playerNearby : boolean
            - prompt : Text
            - activateSound : Sound
            --
            + constructor(...)
            + activate(player)
            + deactivate()
        }
        class InvisibleTrigger {
            + doors : Array
            - boss : any
            + primer : boolean
            --
            + constructor(...)
            + getBoss(boss)
            + getDoors(doorsArray)
            + llamar()
        }
        class TutorialPanel {
            + isActive : boolean
            + playerInRange : boolean
            - textPanel : Graphics
            - textObject : Text
            - panelContainer : Container
            --
            + constructor(...)
            - createTextPanel()
            + showTutorial()
            + hideTutorial()
            + update(player)
            + checkOverlap(player)
            + setPosition(x, y)
            + destroy()
        }
        class Button {
            - color : string
            - door : DoorBoss
            - show : ShowButton
            --
            + constructor(...)
            + setDoor(door)
            + setShow(show)
            + press()
        }
        class ShowButton {
            - textureOff : string
            - textureOn : string
            + isOn : boolean
            --
            + constructor(...)
            + cambio()
        }
        class StaticLava {
            - flowSpeedX : number
            - flowSpeedY : number
            --
            + constructor(...)
            + preUpdate(time, delta)
        }
        class FloorIsLava {
            - riseSpeed : number
            - playerRef : Player
            + isRising : boolean
            --
            + constructor(...)
            + preUpdate(time, delta)
            + startLava()
        }
        class BossRoom {
            - scene : Phaser.Scene
            --
            + constructor(...)
        }
    }
}

