' 1. MOTOR PHASER
package "Phaser Core" #F5F5F5 {
    class Phaser_Game {
        + constructor(config)
    }

    class Phaser_Scene {
        + add : GameObjectFactory
        + physics : ArcadePhysics
        + sound : SoundManager
        + input : InputPlugin
        + time : Clock
        + tweens : TweenManager
        + anims : AnimationManager
        + cameras : CameraManager
        + events : EventEmitter
        + make : TilemapCreator
        + cache : CacheManager
        + load : LoaderPlugin
        + scale : ScaleManager
        + scene : ScenePlugin
        + constructor(key)
        + init(data)
        + preload()
        + create(data)
        + update(time, delta)
    }

    class Phaser_Physics_Arcade_Sprite {
        + body : Body
        + x : number
        + y : number
        + depth : number
        + texture : object
        + flipX : boolean
        + alpha : number
        + scaleX : number
        + scaleY : number
        + setCollideWorldBounds(value)
        + setGravityY(value)
        + setMaxVelocity(x, y)
        + setVelocity(x, y)
        + setVelocityX(x)
        + setVelocityY(y)
        + setImmovable(value)
        + setTint(color)
        + clearTint()
        + setDepth(value)
        + setFlipX(value)
        + setAngle(degrees)
        + setScale(x, y)
        + setOrigin(x, y)
        + setInteractive(config)
        + setTexture(key)
        + setFrame(frame)
        + setPosition(x, y)
        + play(key, ignoreIfPlaying)
        + emit(event, args)
        + on(event, callback)
        + once(event, callback)
        + getBounds()
        + destroy()
        + disableBody(disableGameObject, hideGameObject)
        + enableBody(reset, x, y, show, setEnable)
        + setActive(value)
        + setVisible(value)
    }

    class Phaser_Physics_Arcade_Body {
        + onFloor() : boolean
        + allowGravity : boolean
        + velocity : Vector2
        + enable : boolean
        + moves : boolean
        + onWorldBounds : boolean
        + pushable : boolean
        + setAllowGravity(value)
        + setSize(width, height)
        + setOffset(x, y)
        + setImmovable(value)
        + setGravity(x, y)
    }

    class Phaser_GameObjects_TileSprite {
        + tilePositionX : number
        + tilePositionY : number
        + setOrigin(x, y)
        + setDepth(depth)
        + setScrollFactor(x, y)
        + preUpdate(time, delta)
    }

    class Phaser_GameObjects_Zone {
        + body : Body
        + setOrigin(x, y)
        + setSize(width, height)
        + setInteractive()
        + destroy()
    }

    class Phaser_GameObjects_Image {
        + setScrollFactor(x, y)
        + setScale(scale)
        + setDepth(depth)
        + setAlpha(alpha)
        + setVisible(value)
        + setTexture(key)
        + setFlipX(value)
        + setAngle(degrees)
        + destroy()
    }
}


