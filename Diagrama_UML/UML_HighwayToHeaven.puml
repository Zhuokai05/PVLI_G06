            + constructor(...)
            + cambiarAbrir()
            + abrirPuerta()
            + cerrarPuerta()
        }
        class DoorBoss {
            + contrary : DoorBoss
            - isOpening : boolean
            - prompt : Text
            --
            + constructor(...)
            + getPosition()
            + setContrary(contraryDoor)
            + abrirPuerta()
            + realizarTeletransporte()
            - createAnimations(textureKey)
        }
        class SadnessBossDoor {
            - bottonRojo : boolean
            - bottonAzul : boolean
            - bottonVerde : boolean
