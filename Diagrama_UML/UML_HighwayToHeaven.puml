' 5. MÁQUINA DE ESTADOS 
package "State Machine Core" #FFF3E0 {
    class StateMachine {
        + id : string
        + context : object
        - states : Map
        - currentState : BaseState
        - previousState : BaseState
        --
        + constructor(context, id)
        + addState(name, state)
        + setState(name, data)
        + step(time, delta)
        + getStateName()
    }

    abstract class BaseState {
        + stateMachine : StateMachine
        --
        + constructor()
        + enter(context, data)
        + execute(context, time, delta)
        + exit(context)
    }
}

